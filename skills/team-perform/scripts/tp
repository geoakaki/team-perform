#!/usr/bin/env bash
# team-perform launcher - run from anywhere. Uses the first Python 3.11+ it finds.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for py in python3 python3.14 python3.13 python3.12 python3.11; do
  command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null && break
  py=""
done
[[ -n "$py" ]] || { echo "team-perform needs Python 3.11 or newer (python3 is missing or older)" >&2; exit 1; }
PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m teamperf "$@"
